                { "en": "How old are you?", "pt": "Quantos anos você tem?", "pron": "rau ÔULD ar iu" },
                { "en": "I'm twenty years old.", "pt": "Eu tenho vinte anos.", "pron": "aim TUÊN-ti IIRZ ôuld", "note": "Em inglês a idade usa o verbo \"ser/estar\" (to be), não \"ter\"." },
                { "en": "This is my friend.", "pt": "Este é meu amigo. / Esta é minha amiga.", "pron": "DHIS iz mai FRÉND" }
              ]
