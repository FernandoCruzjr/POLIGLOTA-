                { "en": "Good morning!", "pt": "Bom dia!", "pron": "gud MÓR-nin" },
                { "en": "Good afternoon!", "pt": "Boa tarde!", "pron": "gud é-fter-NUUN" },
                { "en": "Good evening!", "pt": "Boa noite!", "pron": "gud ÍV-nin", "note": "Usado ao CHEGAR em algum lugar à noite." },
                { "en": "Good night!", "pt": "Boa noite!", "pron": "gud NAIT", "note": "Usado ao SE DESPEDIR ou antes de dormir." },
                { "en": "How are you?", "pt": "Como você está?", "pron": "rau ar IU" },
                { "en": "I'm fine, thank you.", "pt": "Estou bem, obrigado(a).", "pron": "aim FAIN, THÉNK-iu" },
